# ==============================================================================
# BABATA LENS — ENVIRONMENT VARIABLE SPECIFICATION (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or real secrets to Git.
#
# NOTE: Not all providers are required! Babata Lens starts gracefully even with
# zero providers configured or missing optional keys.
# ==============================================================================

# --- AI Providers (Configure at least one for Babata conversational intelligence) ---
# Google Gemini API key: https://aistudio.google.com/
GOOGLE_AI_API_KEY=

# Anthropic Claude API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Market Intelligence Providers ---
# CoinGecko Demo / Pro API Key: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# CoinMarketCap API Key: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=

# --- Blockchain Intelligence Providers ---
# Etherscan Developer API Key: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Alchemy API Key / App Key: https://www.alchemy.com/
ALCHEMY_API_KEY=

# Solscan Pro API Key: https://solscan.io/
SOLSCAN_API_KEY=

# --- Analytics Providers ---
# Dune Analytics API Key: https://dune.com/docs/api/
DUNE_API_KEY=

# --- Exchange Providers ---
# BingX API Key & Secret: https://bingx.com/en/account/api/
BINGX_API_KEY=
BINGX_API_SECRET=

# --- Database Storage (Optional for MVP local state, required for persistent history) ---
# PostgreSQL connection string (Supabase, Neon, RDS, or local Postgres)
DATABASE_URL=

# --- Distributed Cache & Rate Limiting (Optional - falls back to memory cache) ---
# Upstash Redis REST credentials: https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Authentication Configuration ---
# Generate secret using: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
